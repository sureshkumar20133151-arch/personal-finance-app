{
  "name": "personal-finance-app",
  "private": true,
  "version": "1.0.3",
  "description": "A smart personal finance and budget tracking application.",
  "author": "Budget Tracker Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "android:run": "cap run android",
    "electron:build": "electron-builder --win"
  },
  "build": {
    "appId": "com.budgettracker.app",
    "productName": "Budget Tracker",
    "asar": true,
    "directories": {
      "output": "dist_nsis",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Budget Tracker"
    },
    "files": [
      "electron/**/*",
      "build/icon.png"
    ]
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@solimanware/capacitor-sms-reader": "^5.0.3",
    "capacitor-razorpay": "^1.3.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.17.3",
    "firebase": "^12.7.0",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.11.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0",
    "transaction-sms-parser": "^3.3.3",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.6"
  }
}
