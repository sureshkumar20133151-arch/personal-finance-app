rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAppOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'sureshkumar20133151@gmail.com' ||
        request.auth.token.email == 'solodeveloper.suresh@gmail.com'
      );
    }

    // 1. Users: Strictly multi-tenant isolated (App Owner can read all & manage plans)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAppOwner();
    }

    // 2. Deleted Users: User can only access their own soft-deleted data
    match /deleted_users/{userId} {
      allow read, write: if isOwner(userId) || isAppOwner();
    }

    // 3. Households: Shared finance collaboration
    match /households/{householdId} {
      // Read: Only household members or the owner
      allow read: if isAuthenticated() && (
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) ||
        resource.data.ownerId == request.auth.uid
      );

      // Create: Any authenticated user can create a new household
      allow create: if isAuthenticated();

      // Update: Existing members or someone adding themselves (joining via invite code)
      allow update: if isAuthenticated() && (
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) ||
        resource.data.ownerId == request.auth.uid ||
        (request.resource.data.memberIds != null && request.auth.uid in request.resource.data.memberIds)
      );

      // Delete: Household owner or sole member
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.memberIds != null && resource.data.memberIds.size() <= 1 && request.auth.uid in resource.data.memberIds)
      );
    }

    // 4. Invite Codes: Authenticated users can read and write household invite codes
    match /householdInviteCodes/{code} {
      allow read, write: if isAuthenticated();
    }

    // 5. Coupons: Authenticated users can read; App Owner can create/update
    match /coupons/{code} {
      allow read: if isAuthenticated();
      allow write: if isAppOwner();
    }

    // 6. Payment Events & Invoices: App Owner can read SaaS metrics
    match /processedPaymentEvents/{eventId} {
      allow read: if isAppOwner();
      allow write: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isAppOwner() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

